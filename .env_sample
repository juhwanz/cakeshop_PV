# Copy this file to .env and enter values for your environment.
# Never commit the completed .env file.

# MariaDB installed directly on each developer's PC.
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=3307
LOCAL_DB_DATABASE=cakeshop
LOCAL_DB_USERNAME=root
LOCAL_DB_PASSWORD=test1234

# RDS connection. The public repository does not define an operational RDS policy.
RDS_ENDPOINT=
RDS_PORT=3306
RDS_DATABASE=
RDS_USERNAME=
RDS_PASSWORD=

# Local directory (outside the project): where uploaded images are stored.
# If unset, defaults to <user home>/cakeshop-uploads.
FILE_UPLOAD_DIR=/absolute/path/to/cakeshop-uploads

# Toss Payments test keys. Used only with the local,toss-test profile combination.
# test_ck_/test_gck_ client keys and test_sk_/test_gsk_ secret keys are accepted.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_CONNECT_TIMEOUT=3s
TOSS_READ_TIMEOUT=5s
PAYMENT_RECOVERY_FIXED_DELAY=60s
PAYMENT_RECOVERY_INITIAL_DELAY=60s
PAYMENT_RECOVERY_BATCH_SIZE=50

# S3 file storage. local,s3 is rejected; operational use is outside the local guide.
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_S3_BUCKET=
AWS_S3_BASE_URL=
AWS_S3_KEY_PREFIX=

# SMTP. local,smtp is rejected; local uses DisabledEmailSender.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=SweetHan

# Google/Kakao OAuth login. Enable the oauth Spring profile after entering all values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# KAKAO_CLIENT_ID is the REST API key from Kakao Developers.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# Solapi SMS. local,sms is rejected.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER_PHONE=
KAKAO_ALIMTALK_PF_ID=
